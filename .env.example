# Copier ce fichier en .env et remplir les valeurs

SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DEBUG=False

# Base de données PostgreSQL (fournie par Neon en production)
DATABASE_URL=postgres://user:password@host/dbname

# Hôtes autorisés (ajouter le domaine Render en production)
ALLOWED_HOSTS=localhost,127.0.0.1,votre-app.onrender.com

# URL du frontend (l'URL Vercel en production)
FRONTEND_URL=https://votre-frontend.vercel.app

# Email Gmail (créer un mot de passe d'application sur myaccount.google.com/apppasswords)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre.email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application-16-caracteres
DEFAULT_FROM_EMAIL=FinanceIQ <votre.email@gmail.com>
