# Copier ce fichier en .env et remplir les valeurs

SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DEBUG=False

# Email Gmail (créer un mot de passe d'application sur myaccount.google.com/apppasswords)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre.email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application-16-caracteres
DEFAULT_FROM_EMAIL=votre.email@gmail.com

# URL du frontend (changer en production)
FRONTEND_URL=http://localhost:5173
